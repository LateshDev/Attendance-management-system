# Attendance Management System - Environment Variables Example
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
# Local SQLite (default if left blank):
# DATABASE_URL=sqlite:///instance/attendance.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance_db

# Initial Admin Credentials (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME="System Administrator"

# Initial Teacher Credentials
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=Teacher@12345
TEACHER_NAME="Prof. Sharma"
